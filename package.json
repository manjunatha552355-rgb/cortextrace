{
  "name": "cortextrace",
  "productName": "Cortextrace",
  "version": "0.1.0",
  "description": "Local-first desktop observability and threat detection for AI agents",
  "license": "Apache-2.0",
  "author": {
    "name": "Manjunatha M",
    "email": "Manjunatha@aiandmlconsultants.com",
    "url": "https://aiandmlconsultants.com/"
  },
  "homepage": "https://github.com/manjunatha552355-rgb/cortextrace#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manjunatha552355-rgb/cortextrace.git"
  },
  "bugs": {
    "url": "https://github.com/manjunatha552355-rgb/cortextrace/issues"
  },
  "type": "module",
  "main": "dist/main.cjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/build.mjs --dev && electron .",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "engine": "node src/cli.ts",
    "synthetic": "node src/synthetic/agent.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "bench": "node tests/perf/ingest.bench.ts",
    "e2e": "node scripts/build.mjs && node scripts/e2e.mjs",
    "icons": "electron scripts/icons.cjs",
    "licenses": "node scripts/licenses.mjs",
    "dist": "node scripts/build.mjs && electron-builder --publish never",
    "dist:win": "node scripts/build.mjs && electron-builder --win --publish never",
    "dist:mac": "node scripts/build.mjs && electron-builder --mac --publish never",
    "dist:linux": "node scripts/build.mjs && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "d3-force": "^3.0.0",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "zod": "^4.6.5"
  }
}
